{
  "name": "aerobrief",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest --run",
    "rotate-secrets": "node scripts/rotate-secrets.ts",
    "migrate-phase2": "node scripts/migrate-phase2.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tools/faa-probe/tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "~0.25.12"
    }
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
