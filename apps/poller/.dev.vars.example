# Copy to .dev.vars for `wrangler dev`. Placeholders only; .dev.vars is gitignored.
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
MAIL_FROM=AeroBrief <alerts@aerobriefs.com>

# Phase 2 feature flags. Absent means off. Only the exact value "true" turns a flag on.
FEATURE_DARK_MODE=false
FEATURE_HIGH_CONTRAST=false
FEATURE_DIGESTS=false
FEATURE_WEBHOOKS=false
# Phase 2 webhooks. WEBHOOK_MASTER_SECRET: set as a Worker secret, at least 32 random characters. Leave empty here.
WEBHOOK_MASTER_SECRET=
# Safe_Send_Mode is on unless exactly "false". Allowlists are comma-separated.
SAFE_SEND_MODE=true
SAFE_SEND_ALLOWLIST_EMAILS=
SAFE_SEND_ALLOWLIST_HOSTS=
# FAA relay (optional Worker secrets). Both empty means the poller calls the FAA directly. Set both or neither.
# FAA_RELAY_SECRET: at least 32 random characters, same value as on Vercel. FAA_RELAY_URL: https://www.aerobriefs.com/api/internal/faa-relay
FAA_RELAY_URL=
FAA_RELAY_SECRET=
