# Placeholders only. Never commit real values.
# Workers read secrets via `wrangler secret put`; use .dev.vars locally.

# Neon Postgres connection string (used by apps/* and packages/db, including drizzle-kit)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Resend API key for transactional email
RESEND_API_KEY=re_your_api_key
# Secret for signing unsubscribe links (use a long random string)
UNSUBSCRIBE_SECRET=replace-with-long-random-string
# Public URL of the web app, used in emailed links
FRONTEND_URL=https://your-app.vercel.app
# Sender address for alert emails (must be a verified Resend domain)
MAIL_FROM=AeroBrief <alerts@your-domain.com>
# Integration tests only (packages/db/test/integration). Point at a dedicated, migrated test
# database such as a Neon branch. Never the production DATABASE_URL. Tests skip when unset.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/TEST_DBNAME?sslmode=require

# Migrations (direct) - used by Drizzle Kit only
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Least-privilege runtime role (SELECT only on airports). Set this as the Workers' DATABASE_URL secret.
RUNTIME_DATABASE_URL=postgresql://RUNTIME_ROLE:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Secret rotation (scripts/rotate-secrets.ts). Local .env only. See docs/secret-rotation.md ---
# These are high-privilege admin credentials. Never set them as Worker secrets or in CI.
# Neon API key (Neon console > Account settings > API keys)
NEON_API_KEY=neon_api_key_here
# Neon project, branch and role whose password is reset. The role must be the one in the Workers' DATABASE_URL.
NEON_PROJECT_ID=neon_project_id_here
NEON_BRANCH_ID=neon_branch_id_here
NEON_ROLE_NAME=neon_role_name_here
# Resend full-access key, used only to create and delete runtime keys
RESEND_ADMIN_API_KEY=resend_admin_key_here
# Id (not the token) of the current runtime key in Resend > API Keys. The script updates it after rotation.
RESEND_API_KEY_ID=resend_key_id_here
# Optional. Resend domain id. If unset, the domain is looked up by name.
RESEND_DOMAIN_ID=resend_domain_id_here
# Optional. Domain name to look up when RESEND_DOMAIN_ID is unset. Defaults to aerobriefs.com.
RESEND_DOMAIN_NAME=your-domain.com

# --- Phase 2 feature flags. Absent means off. Only the exact value "true" turns a flag on. ---
FEATURE_DARK_MODE=false
FEATURE_HIGH_CONTRAST=false
FEATURE_DIGESTS=false
FEATURE_WEBHOOKS=false
# Phase 2 webhooks. WEBHOOK_MASTER_SECRET: set as a Worker secret, at least 32 random characters. Leave empty here.
WEBHOOK_MASTER_SECRET=
# Safe_Send_Mode is on unless exactly "false". Allowlists are comma-separated.
SAFE_SEND_MODE=true
SAFE_SEND_ALLOWLIST_EMAILS=
SAFE_SEND_ALLOWLIST_HOSTS=
